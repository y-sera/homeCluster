# ------------------------------------------------
# This secret is used to unseal HashiCorp Vault.
# ------------------------------------------------
apiVersion: v1
kind: Secret
metadata:
  name: vault
  namespace: vault
type: Opaque
data:
  AWS_ACCESS_KEY_ID: xxxxxx
  AWS_SECRET_ACCESS_KEY: xxxxxx
  VAULT_AWSKMS_SEAL_KEY_ID: xxxxxxx
