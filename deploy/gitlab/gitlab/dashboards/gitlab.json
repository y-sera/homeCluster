        }
      }
    },
    {
      "type": "timeseries",
      "id": 19,
      "title": "実行中ジョブ / 並列数",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 27
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(sidekiq_running_jobs{namespace=\"gitlab\"})",
          "legendFormat": "実行中",
          "refId": "A"
