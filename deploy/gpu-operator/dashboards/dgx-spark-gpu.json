  {
   "type": "timeseries",
   "title": "メモリ使用量 (CPU/GPU 共有)",
   "description": "GB10 はユニファイドメモリのため DCGM の FB メモリ指標 (DCGM_FI_DEV_FB_*) が出ない. node-exporter の MemTotal - MemAvailable で見る",
   "id": 13,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 31
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
